{
  "uid": "retailpulse-overview",
  "title": "RetailPulse Overview",
  "tags": ["retailpulse"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Request rate",
      "description": "Requests per second across all services.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total[5m]))",
          "legendFormat": "requests/s"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error rate",
      "description": "Share of responses that are 5xx. A ratio, so it stays meaningful at any traffic level.",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_errors_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total[5m])), 0.001)",
          "legendFormat": "5xx rate"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "P95 latency",
      "description": "The tail is what users experience as slowness; a mean would hide it.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Services up",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"retailpulse-services\"})",
          "legendFormat": "up"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request rate by service",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(http_requests_total[5m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "P95 latency by service",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Orders",
      "description": "Created, completed and cancelled. Divergence between created and completed is the first sign the saga is stalling.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(orders_created_total[5m])) * 60",
          "legendFormat": "created/min"
        },
        {
          "refId": "B",
          "expr": "sum(rate(orders_completed_total[5m])) * 60",
          "legendFormat": "delivered/min"
        },
        {
          "refId": "C",
          "expr": "sum(rate(orders_failed_total[5m])) * 60",
          "legendFormat": "cancelled/min"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Inventory reservations",
      "description": "Failures here are usually stockouts rather than defects.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(inventory_reservations_total[5m])) * 60",
          "legendFormat": "reserved/min"
        },
        {
          "refId": "B",
          "expr": "sum by (reason) (rate(inventory_reservation_failures_total[5m])) * 60",
          "legendFormat": "failed: {{reason}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Kafka event processing",
      "description": "Duplicates are normal (at-least-once delivery). Dead letters are not.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(kafka_events_produced_total[5m])) * 60",
          "legendFormat": "produced/min"
        },
        {
          "refId": "B",
          "expr": "sum(rate(kafka_events_processed_total[5m])) * 60",
          "legendFormat": "processed/min"
        },
        {
          "refId": "C",
          "expr": "sum(rate(kafka_events_duplicate_total[5m])) * 60",
          "legendFormat": "duplicates/min"
        },
        {
          "refId": "D",
          "expr": "sum(rate(kafka_events_failed_total[5m])) * 60",
          "legendFormat": "dead-lettered/min"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Cache hit ratio",
      "description": "A falling ratio after a deploy usually means an invalidation is firing too aggressively.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(cache_operations_total{result=\"hit\"}[5m])) / clamp_min(sum(rate(cache_operations_total{result=~\"hit|miss\"}[5m])), 0.001)",
          "legendFormat": "hit ratio"
        }
      ]
    }
  ]
}
